{
  "name": "time-provider",
  "private": true,
  "workspaces": [
    "packages/*",
    "website",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp run build && vp run check && node scripts/verify-packages.ts && vp run test --coverage && vp run stryker",
    "dev": "vp run website#dev",
    "prepare": "vp config",
    "build": "vp run -r build",
    "clean": "rimraf -g node_modules packages/**/dist/** packages/**/node_modules/** .stryker-tmp coverage reports/mutation",
    "test": "vp test",
    "check": "vp check && vp run -r check",
    "stryker": "node scripts/check-stryker-runner.ts && stryker run"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@js-temporal/polyfill": "~0.5.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "26.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsonc-parser": "^3.3.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "validate-branch-name": "^1.3.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "qs": "^6.16.1",
    "vitepress>vite": "6.4.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4",
  "catalog": {
    "vite-plus": "~1.4.0",
    "vitest": "~5.0.5"
  },
  "patchedDependencies": {
    "@stryker-mutator/vitest-runner@10.1.1": "patches/@stryker-mutator%2Fvitest-runner@10.1.1.patch",
    "@stryker-mutator/core@10.1.1": "patches/@stryker-mutator%2Fcore@10.1.1.patch"
  },
  "validate-branch-name": {
    "pattern": "^(main)$|^(ai|bugfix|chore|ci|dependabot|docs|feat|feature|fix|hotfix|perf|release|refactor|test)/.+$|^release-please--branches--.+$",
    "errorMsg": "Branch name must be main, a release-please branch, or <type>/<description> (ai, bugfix, chore, ci, dependabot, docs, feat, feature, fix, hotfix, perf, release, refactor, test) - see conventionalbranch.org"
  }
}
