{
  "name": "@time-provider/plugin-moment",
  "version": "0.5.2",
  "private": false,
  "description": "Time-Provider : Moment.js plugin ~ Your single time interface for all your JavaScript / TypeScript projects.",
  "keywords": [
    "clock",
    "date",
    "dependency injection",
    "dependency inversion principle",
    "deterministic",
    "dip",
    "fake",
    "fake timers",
    "fixed",
    "frozen",
    "injection",
    "manual",
    "moment",
    "provider",
    "running",
    "sequential",
    "solid",
    "solid principles",
    "system",
    "time",
    "timers"
  ],
  "homepage": "https://jaenyf.github.io/time-provider/",
  "bugs": {
    "url": "https://github.com/jaenyf/time-provider/issues"
  },
  "license": "MIT",
  "author": "jaenyf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaenyf/time-provider.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./deterministic": "./dist/deterministic.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "release": "npm stage publish --provenance"
  },
  "devDependencies": {
    "@time-provider/core": "workspace:*",
    "moment": "~2.31.0"
  },
  "peerDependencies": {
    "@time-provider/core": "^3.0.0",
    "moment": ">=2.3.0 <2.11.0 || >=2.11.1 <3"
  },
  "engines": {
    "node": ">=20.4.0"
  }
}
