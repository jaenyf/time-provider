{
  "name": "@time-provider/addon-animation-frame",
  "version": "0.5.0",
  "private": false,
  "description": "Time-Provider : Animation Frame API addon ~ Your single time interface for all your JavaScript / TypeScript projects.",
  "keywords": [
    "animation",
    "animation-frame",
    "clock",
    "date",
    "dependency injection",
    "dependency inversion principle",
    "deterministic",
    "dip",
    "fake",
    "fake timers",
    "fixed",
    "frozen",
    "injection",
    "manual",
    "provider",
    "raf",
    "running",
    "sequential",
    "solid",
    "solid principles",
    "system",
    "time",
    "timers"
  ],
  "homepage": "https://jaenyf.github.io/time-provider/",
  "bugs": {
    "url": "https://github.com/jaenyf/time-provider/issues"
  },
  "license": "MIT",
  "author": "jaenyf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaenyf/time-provider.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "deterministic": [
        "./dist/deterministic.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./deterministic": {
      "import": "./dist/deterministic.mjs",
      "require": "./dist/deterministic.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check && deno publish --dry-run --allow-dirty && node ../../scripts/check-docs.ts",
    "prepublishOnly": "vp run build",
    "release": "vp pm stage publish --provenance && deno publish",
    "release:dry-run": "vp pm stage publish --dry-run && deno publish --dry-run"
  },
  "devDependencies": {
    "@time-provider/core": "workspace:*"
  },
  "peerDependencies": {
    "@time-provider/core": "^4.0.0"
  },
  "engines": {
    "node": "^18.18.0 || >=20.4.0"
  }
}
