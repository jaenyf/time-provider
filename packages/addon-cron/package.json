{
  "name": "@time-provider/addon-cron",
  "version": "0.4.1",
  "private": false,
  "description": "Cron scheduling addon for Time-Provider. Inject time. Control it in tests.",
  "keywords": [
    "clock",
    "cron",
    "crontab",
    "date",
    "dependency-injection",
    "dependency-inversion-principle",
    "deterministic",
    "fake-timers",
    "freeze-time",
    "job",
    "job-scheduler",
    "mock",
    "mock-date",
    "mock-time",
    "schedule",
    "scheduler",
    "setinterval",
    "settimeout",
    "solid-principles",
    "testing",
    "time",
    "time-travel",
    "timers",
    "typescript"
  ],
  "homepage": "https://jaenyf.github.io/time-provider/",
  "bugs": {
    "url": "https://github.com/jaenyf/time-provider/issues"
  },
  "license": "MIT",
  "author": "jaenyf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaenyf/time-provider.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "deterministic": [
        "./dist/deterministic.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./deterministic": {
      "import": "./dist/deterministic.mjs",
      "require": "./dist/deterministic.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check": "vp check && deno publish --dry-run --allow-dirty && node ../../scripts/check-docs.ts",
    "prepublishOnly": "vp run build",
    "release": "vp pm stage publish --provenance && deno publish",
    "release:dry-run": "vp pm stage publish --dry-run && deno publish --dry-run"
  },
  "devDependencies": {
    "@time-provider/core": "workspace:*"
  },
  "peerDependencies": {
    "@time-provider/core": "^4.0.0"
  },
  "engines": {
    "node": "^18.18.0 || >=20.4.0"
  }
}
