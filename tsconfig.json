{
  "compilerOptions": {
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@time-provider/*/deterministic": ["./packages/*/src/deterministic"],
      "@time-provider/*": ["./packages/*/src"]
    }
  },
  "include": ["*.ts", "scripts/**/*.ts", "tools/**/*.ts", "website/scripts/**/*.ts"]
}
