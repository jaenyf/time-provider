{
  "$schema": "./node_modules/fallow/schema.json",
  "duplicates": {
    "ignoredClones": [
      // ignore inlined signal getter similarity accros BaseRuntime and ScheduledHandle
      "dup:7128addb:2",
      // ignore the similarity of dispose/isDisposed/[Symbol.dispose] accros time-provider/addons (compat,cron,eta)
      "dup:30dffa00:3",
      // ignore the similarity of dispose/isDisposed/[Symbol.dispose] accros time-provider/addons (animation-frame,eta,idle)
      "dup:a2aca506:3",
      // ignore the similarity of dispose/isDisposed/[Symbol.dispose] accros time-provider/addons (animation-frame,idle deterministic)
      "dup:04d78313:2",
      // ignore the similarity of dispose/isDisposed/[Symbol.dispose] accros time-provider/addons (animation-frame,idle system)
      "dup:48e6c9bf:2",
      // BaseDeterministicRuntime contains code inlined for performance (every vs once)
      "dup:88f92297:2",
      // ignore similarity of deterministic runtime initialization across plugin-moment and plugin-moment-timezone, that would require a useless additional dependency
      "dup:a024a889:2",
      // ignore similarity of runtime-helper across plugin-moment and plugin-moment-timezone, that would require a useless additional dependency
      "dup:4317260c:2"
    ],
    "ignore": [
      // DueHeap contains code inlined for performance
      "packages/core/src/runtimes/deterministic/DueHeap.ts",
      // test-shared maintains duplicated code for test intent clarity and readability
      "packages/test-shared/**",
      "packages/test-e2e/**",
      "packages/test-treeshake/**",
      // benchmark adapters may duplicate code by intent on their public interface
      "tools/benchmark/bench/shared/adapters/*.ts",
      // benchmark scenario declarations are similar
      "tools/benchmark/bench/*-{clock-read,scheduling}.bench.ts",
      // some benchmark scenarii are very similar but still different
      "tools/benchmark/bench/shared/scenarios.ts"
    ]
  },
  "health": {
    "thresholdOverrides": [
      {
        "files": ["packages/core/src/runtimes/deterministic/DueHeap.ts"],
        "reason": "Inlined hot path for performance",
        "maxCyclomatic": 1000,
        "maxCognitive": 1000,
        "maxCrap": 1000
      },
      {
        "files": ["website/**/*"],
        "reason": "Website files are not covered by tests, thus affecting CRAP score",
        "maxCrap": 1000
      },
      {
        "files": ["scripts/*.ts"],
        "reason": "Chore scripts files are not covered by tests, thus affecting CRAP score",
        "maxCrap": 1000
      }
    ]
  },
  "ignoreDependencies": [
    // imported by the Stryker patch (patches/), until Stryker fixes it upstream
    "jsonc-parser",
    // binary used by the fallow VS Code extension
    "@fallow-cli/fallow-cov"
  ],
  "ignoreDependencyOverrides": [
    // force correct audited version of minimatch for stryker
    { "package": "@stryker-mutator/core>minimatch", "source": "package.json" },
    // force correct audited version of vite for vitepress
    { "package": "vitepress>vite", "source": "package.json" }
  ],
  "ignoreUnresolvedImports": [
    // in plugin-dayjs, fallow mis-resolves imports of dayjs files that exist
    "/dayjs/plugin/**"
  ],
  "overrides": [
    {
      // public API reached through interfaces; implementing classes are private
      "files": ["packages/core/src/{builders,runtimes}/**"],
      "rules": { "unused-class-members": "off" }
    },
    {
      // addons and plugins keep a default export alongside the named `addon` or `plugin` (public API)
      "files": ["packages/{addon,plugin}-*/src/{index,deterministic}.ts"],
      "rules": { "duplicate-export-aliases": "off" }
    },
    {
      // benchmark adapters exposed public contracts that are used to perform benchmarking
      "files": ["tools/benchmark/bench/shared/adapters/*.ts"],
      "rules": { "unused-class-members": "off" }
    }
  ],
  "publicPackages": ["@time-provider/*"],
  "workspaces": {
    "settings": {
      "packages/test-e2e": {
        // test-e2e imports time-provider dependencies by paths, directly from build output and also tests typescript 5.2/5.4 floor compatibility
        "ignoreDependencies": ["@time-provider/*", "typescript-5.2", "typescript-5.4"]
      },
      "packages/test-treeshake": {
        // test-treeshake imports time-provider dependencies by paths
        "ignoreDependencies": ["@time-provider/*"]
      },
      "website": {
        // website build also generates test speed comparison against sinon and jest
        "ignoreDependencies": ["sinon", "jest-environment-jsdom"]
      }
    }
  }
}
